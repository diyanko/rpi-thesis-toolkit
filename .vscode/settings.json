{
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "rpi-latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-no-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "rpi-latexmk-xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-no-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "rpi-latexmk-lualatex",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-no-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "RPI Thesis Toolkit: pdfLaTeX + Biber",
      "tools": [
        "rpi-latexmk"
      ]
    },
    {
      "name": "RPI Thesis Toolkit: XeLaTeX + Biber (Unicode)",
      "tools": [
        "rpi-latexmk-xelatex"
      ]
    },
    {
      "name": "RPI Thesis Toolkit: LuaLaTeX + Biber (Unicode)",
      "tools": [
        "rpi-latexmk-lualatex"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.recipe.default": "lastUsed"
}
